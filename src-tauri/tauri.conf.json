{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MusicCast Analyzer",
  "version": "0.1.0",
  "identifier": "dev.local.musiccast-analyzer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MusicCast Analyzer",
        "width": 1240,
        "height": 800,
        "minWidth": 720,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY3Q0U4RkQzNDU1OUI5MTMKUldRVHVWbEYwNC9POTNBNUxOTEF1R1FFK2JrYzluNnlWK1hnNWFNTHRQQk9XUXpOWTNPYUlZRTYK",
      "endpoints": [
        "https://github.com/0x49b/musiccast-analyzer/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
